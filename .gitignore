# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# caches
/coverage
.turbo/
.eslintcache
*.tsbuildinfo

# env files
# .env.local holds the Supabase keys and must never be pushed. The example
# file is the template colleagues copy, so it is deliberately un-ignored.
.env
.env.*
!.env.local.example

# supabase
# The CLI's local scratch state. supabase/migrations/ IS tracked — it is the
# schema, and the app is not reproducible without it.
supabase/.branches/
supabase/.temp/
supabase/.env

# deployment
.vercel

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# editors
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp

# agent tooling
.claude/settings.local.json

# os
.DS_Store
Thumbs.db

# certificates
*.pem
