# Supabase project settings -> Data API / API keys
# Both values are safe to expose in the browser; row level security is what
# protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# --- Teams notifications (optional) ------------------------------------------
# URL of a Teams "Workflows" trigger: When a Teams webhook request is received.
# One per sport, so each channel only hears about its own ladder.
# Leave unset and the ladder simply posts nothing.
# NOT prefixed with NEXT_PUBLIC_ — these must never reach the browser.
TEAMS_WEBHOOK_URL_PINGPONG=
TEAMS_WEBHOOK_URL_FUSSBALL=

# Fallback for any sport without its own webhook above.
TEAMS_WEBHOOK_URL=

# Shared secret protecting /api/notifications/weekly. Use the same value in the
# pg_cron job in supabase/migrations/0003_notifications.sql.
# Generate one with:  openssl rand -hex 32
CRON_SECRET=
